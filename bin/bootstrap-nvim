#!/usr/bin/env bash
set -euo pipefail
nvim_data="${XDG_DATA_HOME:-$HOME/.local/share}/nvim"
if [[ ! -d "$nvim_data/lazy/lazy.nvim" ]]; then
  git clone --filter=blob:none --branch=stable https://github.com/folke/lazy.nvim.git "$nvim_data/lazy/lazy.nvim"
fi
python3 -m venv "$nvim_data/python-provider"
"$nvim_data/python-provider/bin/python" -m pip install --disable-pip-version-check pynvim pillow
nvim --headless '+Lazy! restore' +qa
printf '%s\n' 'Plugins restored. Open Neovim and run :NvimToolsInstall and :NvimParsersInstall.'
