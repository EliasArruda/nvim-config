#!/usr/bin/env bash
set -eu
config_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
font_data="${XDG_DATA_HOME:-$HOME/.local/share}"
font_env="$font_data/nvim/symbols-font-env"
if [[ ! -x "$font_env/bin/python" ]]; then
  python3 -m venv "$font_env"
fi
"$font_env/bin/python" -m pip install 'fonttools==4.66.1' 'resvg-py==0.5.0' 'pillow==12.3.0'
"$font_env/bin/python" "$config_root/scripts/build-symbols-font.py" \
  --output "$font_data/fonts/nvim-symbols/NeovimSymbols-Regular.ttf"
fc-cache -f "$font_data/fonts/nvim-symbols"
printf 'Fonte Symbols instalada. Reabra o Neovide.\n'
