#!/usr/bin/env bash

set -eu

ruby_bindir="$(mise exec -- ruby -e 'print Gem.bindir')"
formatter="$ruby_bindir/erb-format"

if [ ! -x "$formatter" ]; then
	printf '%s\n' "erb-formatter is not installed for $(mise current ruby). Run: mise exec -- gem install erb-formatter --no-document" >&2
	exit 127
fi

exec mise exec -- "$formatter" "$@"
